root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 2

[*.{gradle,py,cc,h}]
indent_style = space
indent_size = 4

[*.{yml,yaml,xml}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
