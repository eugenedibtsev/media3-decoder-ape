<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="APE Sample"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".SampleActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Providers that know the APE MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/x-ape" />
                <data android:mimeType="audio/ape" />
                <data android:mimeType="audio/x-monkeys-audio" />
            </intent-filter>
            <!-- Providers that only know the .ape extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.ape" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.ape" />
            </intent-filter>
        </activity>
    </application>

</manifest>
