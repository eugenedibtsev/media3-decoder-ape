# Normalize line endings; scripts must stay LF to run on Linux/macOS.
* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary test corpus
*.ape binary
*.pcm binary
*.jar binary

